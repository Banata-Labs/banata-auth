{
  "name": "@banata-auth/example-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,yellow \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --env-file=.env.local --watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0 --port 3002",
    "build": "vite build && bun build ./src/server/index.ts --target bun --outdir dist/server",
    "start": "bun --env-file=.env.local ./dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "db:reset": "bun --env-file=.env.local src/server/db/reset.ts"
  },
  "dependencies": {
    "@banata-auth/react": "^0.2.1",
    "@banata-auth/shared": "^0.1.1",
    "@hono/node-server": "^1.19.5",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.89.0",
    "@tanstack/react-query-devtools": "^5.89.0",
    "better-auth": "~1.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.7",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.9.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.3.6",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
