{
	"name": "banata-auth",
	"private": true,
	"workspaces": ["apps/*", "packages/*", "tooling/*"],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev --concurrency=20",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:e2e": "turbo run test:e2e",
		"verify:auth-e2e-scenarios": "node scripts/auth-e2e-scenarios-check.mjs",
		"verify:auth-readiness": "node scripts/auth-production-readiness-check.mjs",
		"verify:auth-production-gate-template": "node scripts/auth-production-gate-template-check.mjs",
		"verify:auth-production-gates": "node scripts/auth-production-gates-check.mjs",
		"verify:auth-local-readiness": "node scripts/auth-local-readiness-check.mjs",
		"verify:auth-maturity-readiness": "node scripts/auth-maturity-readiness-check.mjs",
		"verify:auth-operations-readiness": "node scripts/auth-operations-readiness-check.mjs",
		"verify:auth-security-review": "node scripts/auth-security-review-check.mjs",
		"clean": "turbo run clean && rm -rf node_modules",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "turbo run build --filter='./packages/*' && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.27.0",
		"agent-browser": "^0.3.0",
		"turbo": "^2.3.0",
		"typescript": "^5.7.0"
	},
	"packageManager": "bun@1.3.6",
	"engines": {
		"node": ">=20.0.0"
	},
	"trustedDependencies": ["@biomejs/biome", "agent-browser"]
}
